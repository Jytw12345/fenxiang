name: Keep Render Alive

# 免费版 Render Web Service 15 分钟无流量会自动休眠，下次访问需 ~1 分钟冷启动。
# 本工作流每 5 分钟请求一次服务根路径，保持唤醒，避免客户打开分享时等待冷启动。
# 注意：仅防休眠，不解决“本地 SQLite 在 redeploy 时清空”的问题（DB 需外置或挂持久盘）。

on:
  schedule:
    # 每 5 分钟一次（UTC）。GitHub Actions 的 scheduled 只在默认分支运行。
    - cron: '*/5 * * * *'
  # 手动触发用
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - name: Ping Render service root
        env:
          RENDER_URL: ${{ secrets.RENDER_URL || 'https://fenxiang.onrender.com/' }}
        run: |
          code=$(curl -fsS -o /dev/null -w "%{http_code}" "$RENDER_URL" || echo "000")
          echo "GET $RENDER_URL -> HTTP $code"
          if [ "$code" = "000" ]; then
            echo "::warning::ping 失败（服务不可达或超时）"
          fi
