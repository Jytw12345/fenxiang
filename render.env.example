# ============================================================
# Render 环境变量清单（Render 用的 .env 清单）
# 用途：在 Render 控制台 → 你的 Web Service → Environment 中，逐项填入下面的值。
# 说明：render.yaml 里这些变量标记为 sync:false，不会自动生成，必须手动粘贴。
#       填完点「Save Changes」会触发自动重新部署；如果没自动部署，手动 Trigger Deploy。
# 注意：本文件只是清单/示例，不要把它当成真实 .env 直接部署（密钥别提交到仓库）。
# ============================================================

# ---------------- 基础 ----------------
PORT=3000
# Render 默认磁盘是临时的。若用 sqlite，必须挂持久磁盘；否则重启/重新部署会丢数据。
# 强烈建议改用 Supabase Postgres（见下方 DB 段），前端登录和元数据都走同一托管库。
DATA_DIR=/var/data
UPLOAD_DIR=/var/data/uploads
# 对外基础地址：必须与实际 Render 域名一致，用于生成分享链接 + 微信回调。
BASE_URL=https://fenxiang.onrender.com

# ---------------- Supabase 身份体系（★ 登录链关键，三项齐全才启用）----------------
# 重要：下面三项必须与 public/env.js 里写死的 SUPABASE_URL / SUPABASE_ANON_KEY
#       来自【同一个】Supabase 项目，否则后端 JWT 校验失败，登录链照样断。
SUPABASE_URL=https://csggakvktvqxkugwwlef.supabase.co
# anon key 是公开信息（前端 env.js 已内置同样的值），可直接填。
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNzZ2dha3ZrdHZxeGt1Z3d3bGVmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkyMDY1MjksImV4cCI6MjEwNDc4MjUyOX0.xewPj_t9f_E16jCAkl3KBGWqMN7_UXu7surLqukOz20
# ★★★ 最易漏、最关键：Supabase 控制台 → Settings → API → JWT Settings → JWT Secret（仅后端，勿泄露）
#     缺失或填错 → /api/auth/bootstrap 返回 401 invalid_token → 登录链断裂。
SUPABASE_JWT_SECRET=REPLACE_WITH_YOUR_SUPABASE_JWT_SECRET

# ---------------- 数据库 ----------------
# 方案 A（推荐）：直接用 Supabase 自带的 Postgres（与登录同源，零额外成本，自动建表）
DB_TYPE=postgres
# 复制 Supabase → Settings → Database → Connection string → 选「Session pooler」（端口 5432）。
# 绝不填 Direct connection（仅 IPv6，Render IPv4-only 网络连不上 ENETUNREACH）；
# 也别填 Transaction pooler（6543，pg 持久连接池不兼容）。
DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_SSL=1

# 方案 B（仅演示，不推荐）：sqlite + Render 持久磁盘
# 需要到 Render 控制台挂一个 Disk：Mount Path = /var/data，Size = 1 GB，然后再设：
# DB_TYPE=sqlite

# ---------------- 腾讯云 COS 存储（可选；留空回退本地磁盘，重启可能丢文件）----------------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=fenxiang-1334164762
COS_REGION=ap-nanjing
COS_BASE_URL=

# ---------------- 微信开放平台（可选）----------------
# 真实扫码登录需填 AppID+Secret（网站应用 snsapi_login）；留空则走 sim 演示模式。
# 注：public/wechat-scan.html 已补全，sim 演示生成的二维码现在可正常打开并确认。
WECHAT_APPID=
WECHAT_SECRET=

# ---------------- 注册 / 超级管理员 ----------------
# 留空 = 开放多租户（任意邮箱首位各自建组织）。
# 填域名（如 company.com）= 仅该域名可自助注册，首位成店长，同事自动加入，外域需邀请码。
REGISTER_DOMAIN=
# ★ 超级管理员邮箱（逗号分隔可填多个）。务必填【你登录用的真实邮箱】，否则看不到用户管理面板。
#   行为：该邮箱注册或登录时会被自动提权为超级管理员，可在后台看到
#   「用户管理（含每人使用量/分享数）/ 存储用量 / 操作日志 / 全量分享」并管理所有用户分享。
#   本地开发：config.js 已自带零依赖 .env 加载，直接在项目根 .env 写这一行即可（见 .env 示例）。
SUPER_ADMIN_EMAILS=309953160@qq.com

# ---------------- 源文件预览（PSD/AI/CDR 等，需服务器有 psd_tools+Pillow 的 Python）----------------
PREVIEW_ENABLED=1
PREVIEW_TIMEOUT_MS=60000
PYTHON_PATH=
